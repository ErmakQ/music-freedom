# ChromeDriver (по умолчанию качается под версию Chrome → кэш)
# CHROMEDRIVER_CACHE_DIR=D:\cache\chromedriver
# CHROMEDRIVER_CFT_JSON_URL=https://googlechromelabs.github.io/chrome-for-testing/latest-versions-per-milestone-with-downloads.json
# CHROMEDRIVER_SKIP_CFT=1
# CHROMEDRIVER_PATH=C:\tools\chromedriver.exe
# CHROMEDRIVER_SKIP_AUTOINSTALL=1

# Веб: CORS для фронта (Vite)
# WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WEB_SESSION_SECRET=сгенерируй_длинную_случайную_строку
# WEB_SESSION_HTTPS_ONLY=1
# WEB_REPORT_LIST_CAP=200
# WEB_MAX_UPLOAD_BYTES=524288

# HEADLESS=1
# SITE_ORIGIN=https://eu.hitmoz.com
# LMUSIC_ORIGIN=https://lmusic.kz
# LMUSIC_FALLBACK_ENABLED=1
# MP3_MIRROR_HOSTS=eu.hitmoz.com,eu.hitmotop.com,rus.hitmotop.com
# WAIT_SEC=25
# DELAY=0.5
# MAX_PLAYLIST_LINES=
# MAX_CONCURRENT_JOBS=10
# MAX_DOWNLOAD_BYTES=0
# DOWNLOAD_PARALLEL_WORKERS=10
# RESOLVE_PARALLEL_WORKERS=4
# HITMO_FETCH_TRACK_PAGES=0
# SEARCH_LOAD_ROUNDS=3
# SEARCH_TRY_HTTP_FIRST=1
# HTTP_SEARCH_TIMEOUT=25
# SEARCH_TRANSLIT=extra
